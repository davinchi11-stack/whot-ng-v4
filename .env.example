# ===== Game SERVER (deploy on Render / Railway / Fly) =====
# Port is injected by the host; locally defaults to 3000.
PORT=3000
HOST=0.0.0.0
# Your Vercel site(s), comma-separated, exact origins. REQUIRED when the frontend is on Vercel.
# e.g. ALLOWED_ORIGINS=https://naija-whot.vercel.app,https://www.yourdomain.com
ALLOWED_ORIGINS=
# Seat is held this long (ms) after a disconnect.
RECONNECT_GRACE_MS=60000
# Rooms with nobody connected are deleted after this long (ms).
ROOM_IDLE_MS=600000

# ===== FRONTEND (set in Vercel -> Project Settings -> Environment Variables) =====
# Public URL of the game server. Leave unset for local dev (the Vite proxy handles it).
# e.g. VITE_SOCKET_URL=https://naija-whot-server.onrender.com
VITE_SOCKET_URL=
