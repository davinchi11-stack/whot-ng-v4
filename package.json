{
  "name": "naija-whot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,green \"tsx watch server.ts\" \"vite\"",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
